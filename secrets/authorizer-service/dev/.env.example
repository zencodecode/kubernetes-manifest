# Template env untuk authorizer-service (dev). Salin ke .env lokal (jangan di-commit),
# isi nilainya, lalu: make secret-generate APP=authorizer-service ENV=dev ENV_FILE=<file>
# Nama key di bawah adalah yang dibaca aplikasi (internal/config/*.go).
# ENVIRONMENT, CORS, INTERFACE dan HTTP_*_PORT diatur oleh chart, tidak perlu di sini.

# Postgres (wajib: HOST, USER, PASSWORD, DATABASE)
POSTGRES_HOST=host.k3d.internal
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_SSLMODE=disable

# Redis (wajib: HOST)
REDIS_HOST=host.k3d.internal
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_TLS=
REDIS_PREFIX=

# RabbitMQ (wajib: HOST, USER, PASSWORD)
RABBITMQ_HOST=host.k3d.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# SMTP (wajib: HOST, FROM)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Authorizer

# JWT (wajib: private key PEM; public key opsional, diturunkan dari private key)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_TOKEN_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# OAuth / OIDC (wajib: ISSUER_URL, samakan dengan host ingress publik)
OAUTH_ISSUER_URL=http://dev-public-service.authorizer.local
OAUTH_CODE_EXPIRY=60s
OAUTH_REQUIRE_PKCE=true

# Seed (dipakai Job seed; password min 8 karakter, client secret min 16)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Admin
SEED_APP_CLIENT_SECRET=
